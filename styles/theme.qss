/* ============================================================
   ALLICE — Global Theme
   Inspired by: Claude, Cursor, Linear, Raycast
   ============================================================ */

/* ── Base ── */
QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Inter", "Segoe UI", "SF Pro Display", sans-serif;
    font-size: 13px;
    border: none;
    outline: none;
}

QMainWindow {
    background-color: #0d1117;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #484f58;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}
QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #484f58;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Sidebar ── */
#sidebar {
    background-color: #010409;
    border-right: 1px solid #21262d;
    min-width: 220px;
    max-width: 220px;
}

#sidebar_logo {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 0px 0px 0px 4px;
}

#sidebar_logo_badge {
    color: #7c3aed;
    font-size: 9px;
    font-weight: 600;
    background-color: #1e1b4b;
    border-radius: 3px;
    padding: 1px 5px;
    letter-spacing: 0.5px;
}

#sidebar_section_label {
    color: #484f58;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 4px 16px 2px 16px;
}

/* Sidebar nav buttons */
#nav_btn {
    background: transparent;
    color: #8b949e;
    text-align: left;
    padding: 7px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 400;
    border: none;
}
#nav_btn:hover {
    background-color: #161b22;
    color: #e6edf3;
}
#nav_btn[active="true"] {
    background-color: #1c2128;
    color: #ffffff;
    font-weight: 500;
}

#new_chat_btn {
    background-color: #7c3aed;
    color: #ffffff;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    border: none;
}
#new_chat_btn:hover {
    background-color: #6d28d9;
}
#new_chat_btn:pressed {
    background-color: #5b21b6;
}

/* Model selector */
#model_selector {
    background-color: #161b22;
    color: #8b949e;
    border: 1px solid #21262d;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 11px;
}
#model_selector:hover {
    border-color: #30363d;
    color: #e6edf3;
}
#model_selector QAbstractItemView {
    background-color: #1c2128;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    padding: 4px;
}

/* Conversation items */
#conv_item {
    background: transparent;
    color: #8b949e;
    text-align: left;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    border: none;
}
#conv_item:hover {
    background-color: #161b22;
    color: #e6edf3;
}
#conv_item[active="true"] {
    background-color: #1c2128;
    color: #e6edf3;
}

/* ── Workspace ── */
#workspace {
    background-color: #0d1117;
}

#workspace_header {
    background-color: #0d1117;
    border-bottom: 1px solid #21262d;
}

#workspace_title {
    color: #e6edf3;
    font-size: 14px;
    font-weight: 600;
}

/* Message blocks */
#msg_container_user {
    background-color: transparent;
}
#msg_container_assistant {
    background-color: transparent;
}

#msg_bubble_user {
    background-color: #1f6feb;
    border: 1px solid #388bfd;
    border-radius: 8px;
}
#msg_bubble_assistant {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
}

#msg_role_user {
    color: #c9d8ff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
#msg_role_assistant {
    color: #7c3aed;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

#msg_text {
    color: #e6edf3;
    font-size: 14px;
    line-height: 1.7;
    background: transparent;
}

#msg_text_user {
    color: #e6edf3;
    font-size: 14px;
    background: transparent;
}

/* Code blocks */
#code_block_container {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
}
#code_block_header {
    background-color: #1c2128;
    border-bottom: 1px solid #21262d;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 12px;
}
#code_lang_label {
    color: #7c3aed;
    font-size: 11px;
    font-weight: 600;
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
}
#copy_code_btn {
    background: transparent;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}
#copy_code_btn:hover {
    background-color: #21262d;
    color: #e6edf3;
}

/* Agent status card */
#agent_status_card {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    padding: 10px 14px;
}
#agent_status_label {
    color: #7c3aed;
    font-size: 11px;
    font-weight: 600;
}
#agent_status_text {
    color: #8b949e;
    font-size: 12px;
}
#agent_status_detail {
    color: #8b949e;
    background-color: transparent;
    font-size: 11px;
    padding: 0px 14px 0px 14px;
}

/* ── Input Bar ── */
#input_container {
    background-color: #0d1117;
    border-top: 1px solid #21262d;
    padding: 16px 24px 20px 24px;
}

#input_inner {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
}
#input_inner:focus-within {
    border-color: #7c3aed;
}

#input_field {
    background: transparent;
    color: #e6edf3;
    font-size: 14px;
    border: none;
    padding: 12px 14px;
    selection-background-color: #388bfd40;
}
#input_field::placeholder {
    color: #484f58;
}

#send_btn {
    background-color: #7c3aed;
    color: #ffffff;
    border-radius: 8px;
    border: none;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
    min-width: 60px;
    margin: 6px 8px 6px 0;
}
#send_btn:hover {
    background-color: #6d28d9;
}
#send_btn:pressed {
    background-color: #5b21b6;
}
#send_btn:disabled {
    background-color: #30363d;
    color: #484f58;
}

#attach_btn, #terminal_btn_input {
    background: transparent;
    color: #484f58;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 16px;
    margin: 4px 2px 4px 6px;
}
#attach_btn:hover, #terminal_btn_input:hover {
    background-color: #21262d;
    color: #8b949e;
}

#input_hint {
    color: #484f58;
    font-size: 11px;
    padding: 4px 14px 0px 14px;
}

/* ── Right Panel ── */
#right_panel {
    background-color: #010409;
    border-left: 1px solid #21262d;
    min-width: 260px;
    max-width: 260px;
}

#right_panel_header {
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 12px 16px 8px 16px;
    border-bottom: 1px solid #21262d;
}

#panel_section_title {
    color: #484f58;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

#stat_label {
    color: #8b949e;
    font-size: 11px;
}
#stat_value {
    color: #e6edf3;
    font-size: 11px;
    font-weight: 600;
}

/* Progress bars */
QProgressBar {
    background-color: #21262d;
    border-radius: 2px;
    height: 4px;
    border: none;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 2px;
    background-color: #7c3aed;
}
QProgressBar[warning="true"]::chunk {
    background-color: #f59e0b;
}
QProgressBar[danger="true"]::chunk {
    background-color: #ef4444;
}

/* Status indicator dots */
#status_dot_idle {
    color: #484f58;
    font-size: 8px;
}
#status_dot_thinking {
    color: #f59e0b;
    font-size: 8px;
}
#status_dot_active {
    color: #22c55e;
    font-size: 8px;
}
#status_dot_error {
    color: #ef4444;
    font-size: 8px;
}

/* File editor */
#file_editor_panel {
    background-color: #0d1117;
    border-top: 1px solid #21262d;
}

/* File tree */
#file_tree {
    background: transparent;
    border: none;
    color: #8b949e;
    font-size: 12px;
}
#file_tree::item:hover {
    background-color: #161b22;
    color: #e6edf3;
}
#file_tree::item:selected {
    background-color: #1c2128;
    color: #e6edf3;
}

/* Toggle panel btn */
#toggle_panel_btn {
    background: transparent;
    color: #484f58;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
#toggle_panel_btn:hover {
    background-color: #161b22;
    color: #8b949e;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #21262d;
    width: 1px;
}
QSplitter::handle:hover {
    background-color: #7c3aed;
}

/* ── Terminal Panel ── */
#terminal_panel {
    background-color: #010409;
    border-top: 1px solid #21262d;
}
#terminal_header {
    background-color: #010409;
    border-bottom: 1px solid #21262d;
    padding: 4px 12px;
}
#terminal_label {
    color: #484f58;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}
#terminal_output {
    background-color: #010409;
    color: #22c55e;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    border: none;
    padding: 8px 12px;
}
#terminal_input {
    background-color: #010409;
    color: #22c55e;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    border: none;
    border-top: 1px solid #21262d;
    padding: 6px 12px;
}

/* ── Tooltips ── */
QToolTip {
    background-color: #1c2128;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}
